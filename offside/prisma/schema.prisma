generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  email        String?
  totalPoints  Int      @default(0)
  createdAt    DateTime @default(now())
  predictions  Prediction[]
  boosts       BoostAllowance[]
}

model Match {
  id          String   @id
  homeTeam    String
  awayTeam    String
  homeFlag    String   @default("")
  awayFlag    String   @default("")
  group       String
  kickoff     DateTime
  homeResult  Int?
  awayResult  Int?
  scoredAt    DateTime?
  predictions Prediction[]
}

model Prediction {
  id            String   @id @default(cuid())
  userId        String
  matchId       String
  homeScore     Int
  awayScore     Int
  boosted       Boolean  @default(false)
  pointsAwarded Int?
  submittedAt   DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id])
  match         Match    @relation(fields: [matchId], references: [id])
  @@unique([userId, matchId])
}

model BoostAllowance {
  id      String    @id @default(cuid())
  userId  String
  round   String
  used    Boolean   @default(false)
  usedAt  DateTime?
  user    User      @relation(fields: [userId], references: [id])
  @@unique([userId, round])
}
