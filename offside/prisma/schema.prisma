generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  email        String?
  totalPoints  Int      @default(0)
  createdAt    DateTime @default(now())
  predictions  Prediction[]
  weeklyBoosts WeeklyBoost[]
  seasonArchives SeasonArchive[]
}

model Match {
  // Uses football-data.org's own match id directly (as a string) rather than
  // generating our own — makes fixture syncing across hundreds of matches a
  // simple idempotent upsert instead of fragile team-name matching.
  id          String    @id
  competition String    // competition code: PL, CL, PD, SA, FL1, BL1
  homeTeam    String
  awayTeam    String
  round       String    // e.g. "Matchday 12", "Quarter-final"
  kickoff     DateTime
  homeResult  Int?
  awayResult  Int?
  scoredAt    DateTime?
  predictions Prediction[]

  @@index([kickoff])
  @@index([competition])
}

model Prediction {
  id            String   @id @default(cuid())
  userId        String
  matchId       String
  homeScore     Int
  awayScore     Int
  boosted       Boolean  @default(false)
  pointsAwarded Int?
  submittedAt   DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id])
  match         Match    @relation(fields: [matchId], references: [id])
  @@unique([userId, matchId])
}

// One boost token per user per calendar week (Mon-Sun, ISO week key like
// "2026-W12"). Reassignable between matches within that same week; locked in
// permanently once its holder match kicks off, same reassignment rules as
// before, just re-scoped to a week instead of the whole tournament.

model WeeklyBoost {
  id      String  @id @default(cuid())
  userId  String
  weekKey String
  matchId String?
  user    User    @relation(fields: [userId], references: [id])
  @@unique([userId, weekKey])
}

// A permanent snapshot of a user's points for one competition, taken once
// that competition's season is fully finished (every match we have for it
// is scored). Never overwritten after creation — this is the "view later"
// record; the live leaderboard keeps accumulating across all competitions
// as normal.
model SeasonArchive {
  id          String   @id @default(cuid())
  userId      String
  competition String
  // e.g. "May 2027" — derived from the final match's kickoff date.
  seasonLabel String
  points      Int
  archivedAt  DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
  @@unique([userId, competition, seasonLabel])
}
