generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  email        String?
  totalPoints  Int      @default(0)
  createdAt    DateTime @default(now())
  predictions  Prediction[]
  // The single boost token for the whole tournament. Holds the id of whichever
  // match currently has it assigned, or null if unused. Reassignable between
  // open matches; locked in permanently once its holder match kicks off.
  boostMatchId String?
}

model Match {
  id          String   @id
  homeTeam    String
  awayTeam    String
  homeFlag    String   @default("")
  awayFlag    String   @default("")
  group       String
  kickoff     DateTime
  homeResult  Int?
  awayResult  Int?
  scoredAt    DateTime?
  predictions Prediction[]
}

model Prediction {
  id            String   @id @default(cuid())
  userId        String
  matchId       String
  homeScore     Int
  awayScore     Int
  boosted       Boolean  @default(false)
  pointsAwarded Int?
  submittedAt   DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id])
  match         Match    @relation(fields: [matchId], references: [id])
  @@unique([userId, matchId])
}
